# ===== agent-builder Phase 1 环境变量模板 =====
# 复制为 .env 后填入实际值；启动前确保 HMAC_SECRET / JWT_SECRET ≥ 32 字符
# .env 已加入 .gitignore，永不入仓

# 数据库（SQLAlchemy + asyncpg）
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@postgres:5432/agent_builder

# LangGraph checkpoint 用（psycopg3 同步），Phase 2 启用
POSTGRES_CHECKPOINT_DSN=postgresql://postgres:postgres@postgres:5432/agent_builder

# Redis（jti 黑名单 / slowapi / arq 队列）
REDIS_URL=redis://redis:6379/0

# HMAC 签名密钥（HITL token 用，≥ 32 字符；启动校验，不足直接 sys.exit）
HMAC_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_PLACEHOLDER

# JWT 签名密钥（Session / 邀请 / 邮箱验证 token 用，≥ 32 字符）
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_PLACEHOLDER

# SMTP 服务（邮箱验证 / 邀请 / 通知）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM=noreply@agent-builder.local

# 公网入口 URL（生成邮件链接用）
PUBLIC_BASE_URL=http://localhost:8080

# 内网 API URL（middleware 服务端 fetch 用）
INTERNAL_BASE_URL=http://api:8000

# 默认发件人邮箱（显示用）
DEFAULT_FROM_EMAIL=agent-builder <noreply@agent-builder.local>

# 前端 origin（CORS allow_origins 用）
WEB_ORIGIN=http://localhost:8080

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# 环境名（dev / staging / prod / test）
ENVIRONMENT=dev

# AGENT_BUILDER_* 前缀（替代 flock 原 FLOCK_*）
AGENT_BUILDER_PROJECT_NAME=agent-builder
