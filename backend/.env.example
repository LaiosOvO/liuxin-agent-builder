# agent-builder 环境变量示例
# 复制此文件为 .env 并填写真实值（.env 已在 .gitignore，不会入仓）

# ─────────────────────────────────────────────────────────────────────────────
# 安全密钥（强制，启动时校验 ≥ 32 字节，否则服务拒绝启动）
# ─────────────────────────────────────────────────────────────────────────────
HMAC_SECRET=<your-hmac-secret-at-least-32-bytes>
JWT_SECRET=<your-jwt-secret-at-least-32-bytes>

# ─────────────────────────────────────────────────────────────────────────────
# 数据库 / 缓存（强制）
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/agent_builder
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# 公网地址（HITL 回调链接生成用，强制）
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# LLM Providers（按需配置，至少配一个 LLM 节点才可用）
# 无 provider 配置时服务仍可启动，但 LLM 节点调用会失败
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZHIPUAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────
# 邮件（HITL 邮件通知，Phase 3 启用）
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<your-smtp-user>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM=noreply@example.com

# ─────────────────────────────────────────────────────────────────────────────
# IM Providers — 企微 WeCom（Plan 04-07）
# 应用消息路径（user-targeted）：三字段必需
# Bot Webhook fallback（仅群投递）：可选；当应用消息凭据缺失时自动启用
# 两种凭据可同时配置；运行时按 use_bot_fallback 切换
# ─────────────────────────────────────────────────────────────────────────────
WECOM_CORP_ID=<your-corp-id>
WECOM_AGENT_ID=<your-agent-id>
WECOM_SECRET=<your-app-secret>
WECOM_BOT_WEBHOOK_KEY=<your-bot-webhook-key>
